# Copy this file to .env and fill in your own values. Never commit .env.

# --- PayPal sandbox (https://developer.paypal.com > Apps & Credentials > Sandbox) ---
# Leave both empty to run in SIMULATION mode (no network calls to PayPal).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Tollgate is sandbox-only on purpose. "live" is refused at startup.
PAYPAL_MODE=sandbox

# --- AI risk check (optional) ---
# With a key, an LLM reviews each request. Without one, a built-in heuristic is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Server ---
PORT=3000
# If set, approving/rejecting requests and editing the policy requires this token.
ADMIN_TOKEN=
